<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/connect_ambient_background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Logo area -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Wand"
            android:textSize="34sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="远程 CLI 控制台"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <!-- Auto-connect loading state -->
        <LinearLayout
            android:id="@+id/autoConnectGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/liquid_panel_background"
            android:elevation="1dp"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/autoConnectStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auto_connecting"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <!-- Cancel + switch server actions, immediately tappable so the
                 user is not stuck waiting for the 5s socket timeout if the
                 saved server is unreachable. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelAutoConnectButton"
                    style="@style/Wand.Connect.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel_auto_connect"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switchServerButton"
                    style="@style/Wand.Connect.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/switch_server"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Form group (hidden during auto-connect) -->
        <LinearLayout
            android:id="@+id/formGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/liquid_panel_background"
            android:elevation="1dp"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <!-- URL input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Wand.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/server_url_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textCursorDrawable="@null"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Status message -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textColor="@color/error"
                android:visibility="gone" />

            <!-- Connect button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                style="@style/Wand.Connect.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/connect_button"
                android:textSize="15sp" />

            <!-- Scan QR button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanQrButton"
                style="@style/Wand.Connect.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/scan_qr_button"
                android:textSize="15sp"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="textStart" />

            <!-- Recent servers section -->
            <TextView
                android:id="@+id/recentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/recent_servers"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:textStyle="normal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
